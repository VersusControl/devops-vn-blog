{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": [
        "arn:*:logs:*:*:log-group:/aws/elb-proxy/*",
        "arn:*:logs:*:*:log-group:/aws/elb-proxy/*:log-stream:*"
      ]
    }
  ]
}
